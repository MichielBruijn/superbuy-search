{
  "manifest_version": 2,
  "name": "Superbuy Zoeker",
  "version": "0.3.1",
  "description": "Slimmer zoeken op Superbuy (Taobao, 1688, Xianyu) met Claude. Koppelt je Superbuy-sessie aan de superbuy-search bridge, op deze pc of via je LAN/VPN.",
  "homepage_url": "https://github.com/MichielBruijn/superbuy-search",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "superbuy-search@bruijn.nu",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/MichielBruijn/superbuy-search/main/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "*://*.superbuy.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Superbuy Zoeker openen"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.superbuy.com/*",
        "https://m.superbuy.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "http://*/*"
  ],
  "options_ui": {
    "page": "options.html"
  }
}
